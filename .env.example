SEASON=2026
FERNET_KEY=            # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANTHROPIC_API_KEY=     # optional — AI panels disabled if empty
DB_PATH=./data/edge.db
SYNC_CRON=0 5 * * *

# ESPN read API host — single constant so a future move is a one-line change (SPEC 2.2)
ESPN_API_HOST=https://lm-api-reads.fantasy.espn.com

# Bind localhost-only by default; the DB holds ESPN session cookies (SPEC 3)
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# Optional cookies for the verify CLI (`python -m api.verify ... `) so you don't have
# to type them at the hidden prompt each run. Copy from a logged-in fantasy.espn.com
# browser session (SPEC 2.3): SWID keeps its curly braces, espn_s2 is a long string.
# These live ONLY in .env (gitignored) — never commit them; the CLI never takes them as args.
ESPN_SWID=             # e.g. {ABCD1234-...}
ESPN_S2=               # long opaque string

# Phase 30 private-local recovery. Keep RECOVERY_REQUIRED=false until the
# off-device restore and retention gates pass. Values are paths/versions only;
# the repository password belongs in macOS Keychain, never this file.
RECOVERY_REQUIRED=false
RECOVERY_REPOSITORY=
RECOVERY_RESTIC_PATH=
RECOVERY_RESTIC_VERSION=0.19.1
RECOVERY_RESTIC_SHA256=
RECOVERY_CREDENTIAL_COMMAND=
RECOVERY_STATE_PATH=./data/recovery-state.json
RECOVERY_LOCK_PATH=./data/recovery.lock
RECOVERY_SCRATCH_PATH=./data/recovery-scratch
RECOVERY_STALE_AFTER_SECONDS=86400
RECOVERY_API_MIN_INTERVAL_SECONDS=60

# REQUIRED. The app refuses to start without it.
#   private_operator  - your own machine, real ESPN data, your credentials
#   public_synthetic  - hosted/CI, synthetic fixtures only; the provider class
#                       cannot be constructed and credentials cannot be decrypted
APP_MODE=private_operator

# REQUIRED (Phase 32). Provider telemetry: records one row per HTTP attempt at the
# EspnService boundary and writes an offline report. Neither is defaulted — the app
# refuses to start without both, so nobody gets recording (or loses it) by accident.
#   TELEMETRY_ENABLED=false  - nothing recorded, no gate, no file
#   TELEMETRY_ENABLED=true   - one row per attempt; the report is rewritten in full
TELEMETRY_ENABLED=false
TELEMETRY_REPORT_PATH=./docs/evidence/phase-32-report.md
