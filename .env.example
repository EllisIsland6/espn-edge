SEASON=2026
FERNET_KEY=            # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANTHROPIC_API_KEY=     # optional — AI panels disabled if empty
DB_PATH=./data/edge.db
SYNC_CRON=0 5 * * *

# ESPN read API host — single constant so a future move is a one-line change (SPEC 2.2)
ESPN_API_HOST=https://lm-api-reads.fantasy.espn.com

# Bind localhost-only by default; the DB holds ESPN session cookies (SPEC 3)
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# Optional cookies for the verify CLI (`python -m api.verify ... `) so you don't have
# to type them at the hidden prompt each run. Copy from a logged-in fantasy.espn.com
# browser session (SPEC 2.3): SWID keeps its curly braces, espn_s2 is a long string.
# These live ONLY in .env (gitignored) — never commit them; the CLI never takes them as args.
ESPN_SWID=             # e.g. {ABCD1234-...}
ESPN_S2=               # long opaque string
