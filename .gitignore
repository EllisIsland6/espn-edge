# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Env / secrets — never commit cookies or keys
.env

# Data — SQLite DB and raw ESPN JSON cache hold session cookies; never commit
/data/edge.db
/data/edge.db-journal
/data/edge.db-wal
/data/edge.db-shm
/data/raw_cache/*
!/data/raw_cache/.gitkeep

# Node / Vite
/web/node_modules/
/web/dist/
/web/.vite/
*.tsbuildinfo

# Playwright
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/.playwright/

# OS
.DS_Store

# Recovery runtime state — lock, scratch staging and the stage machine's
# current position. Machine-local, rewritten on every run, and the scratch
# directory holds restored database material.
/data/recovery-scratch/
/data/recovery-state.json
/data/recovery.lock
.DS_Store

# Claude Code local overrides (settings.json is shared, .local.json is not)
.claude/settings.local.json

# Terraform: provider caches and any local state. The stack root uses the S3 backend; the bootstrap root's state stays with the account, never here.
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
infra/terraform/stack/plan.txt
infra/terraform/stack/plan.json
