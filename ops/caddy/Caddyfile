# The origin. CloudFront is the only legitimate client; it proves it with a
# header the task reads from Secrets Manager. The security group already
# limits who can connect; this limits who gets an answer.
#
# Environment (all set by the ECS task definition):
#   ORIGIN_HOSTNAME     origin.<domain>
#   ACME_EMAIL          the operator
#   ORIGIN_VERIFY       the shared secret CloudFront sends as X-Origin-Verify
#   AWS_REGION, AWS_HOSTED_ZONE_ID
#
# Credentials for DNS-01 come from the task role via the ECS metadata
# endpoint; nothing is configured here.

{
	email {$ACME_EMAIL}
	# No cert_issuer lines on purpose. With an email set, Caddy's defaults are
	# Let's Encrypt with ZeroSSL (ACME) as the fallback -- what amendment C3
	# asks for. Spelling it out as `cert_issuer zerossl` is what killed the
	# first web task: in current Caddy that form is the ZeroSSL *API* issuer
	# and demands an API key -- "wrong argument count or unexpected line
	# ending after 'zerossl'" -- and the process exited 1 before it had a
	# logger, so CloudWatch showed nothing. MEASURED with `caddy adapt`.
}

{$ORIGIN_HOSTNAME} {
	tls {
		dns route53 {
			region {$AWS_REGION}
			hosted_zone_id {$AWS_HOSTED_ZONE_ID}
		}
	}

	# Anything without the header is not CloudFront. 403, not 404: there
	# is nothing to look for here.
	@not_cloudfront not header X-Origin-Verify {$ORIGIN_VERIFY}
	respond @not_cloudfront 403

	# The application listens on the task's bridge network as `app`.
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {$ORIGIN_HOSTNAME}
	}

	log {
		output stdout
		format json
	}
}
