#!/bin/sh
# Restic password-command helper. The secret stays in macOS Keychain and is
# written only to restic's private pipe; callers must never capture this output.
operator_account=$(/usr/bin/id -un) || exit 1
exec /usr/bin/security find-generic-password \
  -a "${operator_account}" \
  -s "com.espn-edge.private-recovery" \
  -w
