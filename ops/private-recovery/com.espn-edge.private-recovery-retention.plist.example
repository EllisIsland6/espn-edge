<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.espn-edge.private-recovery-retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>ABSOLUTE_REPO_PATH/.venv/bin/python</string>
    <string>-m</string><string>api.recovery</string>
    <string>retention</string><string>--apply</string>
  </array>
  <key>WorkingDirectory</key><string>ABSOLUTE_REPO_PATH</string>
  <key>StartCalendarInterval</key>
  <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict>
</plist>
